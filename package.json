{
  "name": "niam-microservices-demo",
  "version": "1.0.0",
  "description": "Two independent ElysiaJS microservices consuming the nIAM STS as an external IAM provider. Pure wire clients — no IAM internals.",
  "private": true,
  "scripts": {
    "demo:payments": "bun run payments-svc.ts",
    "demo:orders": "bun run orders-svc.ts",
    "demo:reports": "bun run reports-svc.ts",
    "demo:run": "bun run run.ts",
    "demo:report": "bun run report-live.ts",
    "demo:test": "bun test demo.test.ts",
    "hr:dev": "bun run --cwd hr-software dev",
    "hr:start": "bun run --cwd hr-software start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.4.29",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "latest"
  }
}
